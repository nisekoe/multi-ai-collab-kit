{
  "_note": "传球门判据表（供 pass_gate.py 使用）：修改规则只需改此 JSON，无需改动脚本。",
  "_兜底": "没有任何规则明确允许自己单独做时，按 fail-closed 交出去。",
  "请求草稿": {
    "字段": [
      "trace_id（第N步-接手方-日期）",
      "要解决的问题（一句话）",
      "已知事实与证据路径",
      "已试过什么与结果",
      "期望接手方做什么（next）",
      "验收标准"
    ]
  },
  "违规提醒": "未按规则交接或越权执行不可逆操作均视为违规。",
  "规则": [
    {
      "id": "R1",
      "命中": {"risk": "red"},
      "结论": "交出去",
      "找谁": "用户",
      "理由": "涉及删除、外发、付费或不可逆改动，必须由用户本人当轮确认。"
    },
    {
      "id": "R2",
      "命中": {"owner": "theirs"},
      "结论": "交出去",
      "找谁": "身体那一方",
      "理由": "属于对方独占写边界的配置或代码，不越权代改。"
    },
    {
      "id": "R3",
      "命中": {"blind_spot": true},
      "结论": "交出去",
      "找谁": "对方（当见证人）",
      "理由": "处于自身盲区（如重启自身或无法自证状态），须由对方协助验证。"
    },
    {
      "id": "R4",
      "命中": {"evidence": ["vague", "none"]},
      "结论": "交出去",
      "找谁": "对方",
      "理由": "证据无法指认（unresolved），不得凭猜测继续执行。"
    },
    {
      "id": "R5",
      "命中": {"tries": ">=2"},
      "结论": "交出去",
      "找谁": "对方",
      "理由": "同一方案连续尝试达到 2 次仍未通过，交由对方复核或换视角排查。"
    },
    {
      "id": "R6",
      "命中": {"risk": "green", "owner": "mine", "blind_spot": false, "evidence": "pointable"},
      "结论": "自己做",
      "找谁": "—",
      "理由": "低风险、在自身写边界内、无盲区且证据可指认，可直接执行。"
    }
  ]
}
